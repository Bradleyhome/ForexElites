<script>
const API_URL = "https://script.google.com/macros/s/AKfycbyOeJarLWLpK0Xey1nzkH1OMbqdX3DrchinA54m8WeWESQ7VHf9wQyr0p2WCMmOPi2O/exec";
const FIXED_KES = 26000;
const FIXED_USD = 199;
const FIXED_RATE = 130;

(function init(){
  const params = new URLSearchParams(location.search);
  let ref = params.get('ref') || localStorage.getItem('forexelites_ref') || "";
  if(params.get('ref')){localStorage.setItem('forexelites_ref', params.get('ref')); trackClick(params.get('ref'));}
  if(ref){document.getElementById('refBanner').classList.add('show');document.getElementById('refName').textContent=ref;document.getElementById('refInline').textContent=ref;}
  const savedEmail = localStorage.getItem('forexelites_email');
  const confirmed = params.get('confirmed');
  if(savedEmail){document.getElementById('emailInput').value=savedEmail;document.getElementById('buyerEmail').value=savedEmail;document.getElementById('myRefLink').textContent=location.origin+location.pathname+"?ref="+savedEmail.split('@')[0];}
  if(confirmed==="1" && savedEmail){document.getElementById('emailCard').style.display='none';document.getElementById('payCard').style.display='block';}
})();

async function trackClick(referrer){try{await fetch(API_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'click',referrer:referrer,product:'Gadaffi Elite Automated Scanner',url:location.href,priceKES:FIXED_KES,rate:FIXED_RATE})});}catch(e){}}

async function handleEmailCapture(){
  const email = document.getElementById('emailInput').value.trim().toLowerCase();
  const ref = localStorage.getItem('forexelites_ref') || "";
  const btn = document.getElementById('emailBtn');
  const success = document.getElementById('emailSuccess');
  if(!email.includes('@')){alert('Enter valid email');return;}
  btn.disabled=true;btn.textContent='Locking referral...';
  try{
    const res = await fetch(API_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'lead',email:email,referrer:ref,product:'Gadaffi Elite Automated Scanner',url:location.href,priceKES:FIXED_KES,priceUSD:FIXED_USD,rate:FIXED_RATE})});
    const data = await res.json();
    if(data.success){
      localStorage.setItem('forexelites_email',email);
      document.getElementById('buyerEmail').value=email;
      document.getElementById('myRefLink').textContent=location.origin+location.pathname+"?ref="+email.split('@')[0];
      success.style.display='block';
      success.innerHTML=`✅ Confirmation email sent to <b>${email}</b><br>Referrer <b>${ref||'Direct'}</b> locked at KSh 26,000 fixed<br>Check inbox + spam.`;
      setTimeout(()=>{document.getElementById('payCard').style.display='block';window.scrollTo({top:document.getElementById('payCard').offsetTop-20,behavior:'smooth'});},800);
    }
  }catch(err){
    localStorage.setItem('forexelites_email',email);
    success.style.display='block';
    success.innerHTML=`✅ Email captured for <b>${email}</b> at KSh 26,000 fixed<br>Referrer <b>${ref||'Direct'}</b> locked.<br>Pay card unlocked below.`;
    document.getElementById('payCard').style.display='block';
  }
  btn.disabled=false;btn.textContent='Get Confirmation Link → Lock My Referral';
}

async function handleSale(){
  const tx = document.getElementById('txCode').value.trim();
  const email = document.getElementById('buyerEmail').value.trim().toLowerCase();
  if(!tx || !email){alert('Enter Tx Code and Email');return;}
  const ref = localStorage.getItem('forexelites_ref') || "";
  const success = document.getElementById('saleSuccess');
  try{
    const res = await fetch(API_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'sale',buyer:email.split('@')[0],buyerEmail:email,referrer:ref,product:'Gadaffi Elite Automated Scanner',price:FIXED_USD,priceKES:FIXED_KES,exchangeRate:FIXED_RATE,paymentMethod:'M-Pesa Till 6282142',amount:FIXED_KES,amountUSD:FIXED_USD,txCode:tx})});
    const data = await res.json();
    if(data.success){success.style.display='block';success.innerHTML=`🎉 Payment recorded! Tx: <b>${tx}</b><br>Paid KSh 26,000 Fixed ($199 @ 130)<br>License to <b>${email}</b><br>Referrer <b>${ref||'Direct'}</b> credited KSh 2,600.`;}
  }catch(err){success.style.display='block';success.innerHTML=`Payment noted for <b>${email}</b> Tx <b>${tx}</b> KSh 26,000. Referrer ${ref||'Direct'} tracked.`;}
}

function generateLink(){
  const email = localStorage.getItem('forexelites_email') || document.getElementById('emailInput').value.trim();
  if(!email || !email.includes('@')){alert('Enter email first');return;}
  const link = location.origin+location.pathname+"?ref="+email.split('@')[0];
  document.getElementById('myRefLink').textContent=link;
  navigator.clipboard.writeText(link).then(()=>alert('Link copied: '+link));
}
</script>
