<body>
<div class="container">
  <span class="badge">LIVE - $199 / 12 MONTHS</span>
  <h1>Gadaffi Elite Automated Scanner</h1>
  <p class="sub">Enter your email to get instant access link. Even if you don't buy today, your referrer stays tracked for 12 months. 5-Level Affiliate: 10%/8%/7%/6%/5% = $71.64 per sale.</p>
  
  <div id="refBox" class="ref-box">Checking referral...</div>
  
  <form id="leadForm">
    <input type="email" id="email" placeholder="Enter your best email address" required>
    <button type="submit" id="submitBtn">Get Access Link →</button>
  </form>
  
  <div id="successBox" class="success"></div>
  
  <div class="till">
    After confirmation, pay via <b>M-Pesa Till 6282142</b><br>
    <span style="font-size:12px;color:#94a3b8;">Amount: $199 (KES equivalent) - Product: Gadaffi Elite Scanner</span>
  </div>
</div>

<script>
// Same API URL you have live
const API_URL = "https://script.google.com/macros/s/AKfycbyOeJarLWLpK0Xey1nzkH1OMbqdX3DrchinA54m8WeWESQ7VHf9wQyr0p2WCMmOPi2O/exec";

(function initRef(){
  const params = new URLSearchParams(window.location.search);
  const ref = params.get('ref') || localStorage.getItem('forexelites_ref') || "";
  const emailParam = params.get('email');
  
  if (params.get('ref')) {
    localStorage.setItem('forexelites_ref', params.get('ref'));
    trackClick(params.get('ref'));
  }
  
  const refBox = document.getElementById('refBox');
  if (ref) {
    refBox.innerHTML = `✅ Referral tracked: <b style="color:#22c55e;">${ref}</b> will earn commission when you buy`;
    refBox.style.borderColor = "#22c55e";
    refBox.style.color = "#e2e8f0";
  } else {
    refBox.innerHTML = `Direct visit - no referrer (enter ref link like ?ref=username for tracking)`;
  }
  
  // If already confirmed email in URL, prefill
  if (emailParam) document.getElementById('email').value = emailParam;
})();

async function trackClick(referrer){
  try{
    await fetch(API_URL, {method:'POST', mode:'no-cors', headers:{'Content-Type':'application/json'}, body: JSON.stringify({action:'click', referrer: referrer, product:'Gadaffi Elite Automated Scanner', url: location.href})});
  }catch(e){}
}

document.getElementById('leadForm').addEventListener('submit', async function(e){
  e.preventDefault();
  const email = document.getElementById('email').value.trim().toLowerCase();
  const referrer = localStorage.getItem('forexelites_ref') || "";
  const btn = document.getElementById('submitBtn');
  const successBox = document.getElementById('successBox');
  
  if (!email.includes('@')) { alert('Enter valid email'); return; }
  
  btn.disabled = true;
  btn.textContent = 'Sending confirmation email...';
  
  try {
    const res = await fetch(API_URL, {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({action:'lead', email: email, referrer: referrer, product:'Gadaffi Elite Automated Scanner', url: location.href})});
    const data = await res.json();
    
    if (data.success) {
      successBox.style.display = 'block';
      successBox.innerHTML = `✅ <b>Confirmation email sent to ${email}</b><br><br>Check your inbox (and spam) and click the confirmation link.<br><br>Referrer <b>${referrer || 'Direct'}</b> is now locked to your email for 12 months - even if you buy later, they get paid.<br><br><small>Token: ${data.token.substring(0,8)}... (for debugging)</small>`;
      document.getElementById('leadForm').style.display = 'none';
      // Save email locally
      localStorage.setItem('forexelites_email', email);
    } else {
      alert('Error: ' + (data.error || 'Failed to send'));
      btn.disabled = false;
      btn.textContent = 'Get Access Link →';
    }
  } catch(err) {
    // Even with no-cors, it may still have sent
    successBox.style.display = 'block';
    successBox.innerHTML = `✅ Email captured for <b>${email}</b><br>Check your inbox for confirmation link. Referrer <b>${referrer || 'Direct'}</b> tracked.<br><br><small>If email doesn't arrive in 2 mins, contact support - lead still saved in sheet.</small>`;
    document.getElementById('leadForm').style.display = 'none';
  }
});
</script>
